<Application x:Class="NexaRetail.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>

        <SolidColorBrush x:Key="PrimaryBlueBrush"
                         Color="#2196F3"/>

        <SolidColorBrush x:Key="TextPrimaryBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="TextSecondaryBrush"
                         Color="#8FA7D8"/>

        <LinearGradientBrush x:Key="LoginBackgroundBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#061333" Offset="0"/>
            <GradientStop Color="#0B1D52" Offset="0.5"/>
            <GradientStop Color="#30106B" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="InputBackgroundBrush"
                         Color="#101E4A"/>

        <SolidColorBrush x:Key="InputBorderBrush"
                         Color="#3159A8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="20"
                          ShadowDepth="5"
                          Opacity="0.35"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          BlurRadius="12"
                          ShadowDepth="3"
                          Opacity="0.30"/>

    </Application.Resources>

</Application>