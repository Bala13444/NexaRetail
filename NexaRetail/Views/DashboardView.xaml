<UserControl x:Class="NexaRetail.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4F7FC">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="#08143A">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>


                <!-- LOGO -->

                <StackPanel Grid.Row="0"
                            VerticalAlignment="Center"
                            Margin="25,0">

                    <TextBlock Text="NEXARETAIL"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="ERP MANAGEMENT SYSTEM"
                               FontSize="8"
                               Foreground="#7FA4E8"
                               Margin="0,4,0,0"/>

                </StackPanel>


                <!-- MENU -->

                <StackPanel Grid.Row="1"
                            Margin="15,20,15,0">

                    <!-- DASHBOARD -->

                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="#1D4ED8"
                            BorderThickness="0"
                            Foreground="White"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="▣"
                                       FontSize="16"
                                       Width="35"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Dashboard"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <!-- SALES -->

                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◈"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Sales"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>


                    <!-- PURCHASE -->

                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◈"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Purchase"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>


                    <!-- INVENTORY -->

                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◈"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Inventory"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>


                    <!-- CUSTOMERS -->

                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◈"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Customers"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>


                    <!-- SUPPLIERS -->

                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◈"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Suppliers"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>


                    <!-- REPORTS -->

                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◈"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Reports"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>


                    <!-- SETTINGS -->

                    <Button Height="48"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⚙"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Settings"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>

                </StackPanel>


                <!-- USER -->

                <Border Grid.Row="2"
                        BorderBrush="#263B67"
                        BorderThickness="0,1,0,0">

                    <StackPanel Margin="20,12">

                        <TextBlock Text="System Administrator"
                                   FontSize="11"
                                   Foreground="White"/>

                        <TextBlock Text="Administrator"
                                   FontSize="9"
                                   Foreground="#7FA4E8"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <Grid Grid.Column="1"
              Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- TOP BAR -->

            <Grid Grid.Row="0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Dashboard"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="#15213F"/>

                    <TextBlock Text="Welcome back to NexaRetail"
                               FontSize="11"
                               Foreground="#71809F"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <!-- USER -->

                <Border HorizontalAlignment="Right"
                        Width="190"
                        Height="48"
                        Background="White"
                        CornerRadius="8">

                    <StackPanel VerticalAlignment="Center"
                                Margin="15,0">

                        <TextBlock Text="System Administrator"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#15213F"/>

                        <TextBlock Text="Administrator"
                                   FontSize="9"
                                   Foreground="#71809F"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- DASHBOARD CARDS -->

            <Grid Grid.Row="1"
                  Margin="0,20,0,0">

                <Grid.RowDefinitions>

                    <RowDefinition Height="150"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- SALES -->

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        Background="White"
                        CornerRadius="10">

                    <StackPanel Margin="20">

                        <TextBlock Text="SALES"
                                   FontSize="11"
                                   Foreground="#71809F"/>

                        <TextBlock Text="₹ 0.00"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#15213F"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Today's Sales"
                                   FontSize="9"
                                   Foreground="#71809F"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- PURCHASE -->

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Margin="6,0"
                        Background="White"
                        CornerRadius="10">

                    <StackPanel Margin="20">

                        <TextBlock Text="PURCHASE"
                                   FontSize="11"
                                   Foreground="#71809F"/>

                        <TextBlock Text="₹ 0.00"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#15213F"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Today's Purchase"
                                   FontSize="9"
                                   Foreground="#71809F"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- INVENTORY -->

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Margin="6,0"
                        Background="White"
                        CornerRadius="10">

                    <StackPanel Margin="20">

                        <TextBlock Text="INVENTORY"
                                   FontSize="11"
                                   Foreground="#71809F"/>

                        <TextBlock Text="0"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#15213F"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Total Items"
                                   FontSize="9"
                                   Foreground="#71809F"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- CUSTOMERS -->

                <Border Grid.Row="0"
                        Grid.Column="3"
                        Margin="12,0,0,0"
                        Background="White"
                        CornerRadius="10">

                    <StackPanel Margin="20">

                        <TextBlock Text="CUSTOMERS"
                                   FontSize="11"
                                   Foreground="#71809F"/>

                        <TextBlock Text="0"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#15213F"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Total Customers"
                                   FontSize="9"
                                   Foreground="#71809F"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- LOWER AREA -->

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="0,20,0,0"
                        Background="White"
                        CornerRadius="10">

                    <StackPanel Margin="25">

                        <TextBlock Text="Recent Activity"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#15213F"/>

                        <TextBlock Text="Your recent sales, purchases and inventory activity will appear here."
                                   FontSize="11"
                                   Foreground="#71809F"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>