<UserControl x:Class="NexaRetail.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4F7FC">

        <StackPanel Margin="30">

            <TextBlock Text="Sales"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#15213F"/>

            <TextBlock Text="Manage sales transactions"
                       FontSize="12"
                       Foreground="#71809F"
                       Margin="0,5,0,25"/>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="25">

                <StackPanel>

                    <TextBlock Text="Sales Module"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#15213F"/>

                    <TextBlock Text="The sales transaction screen will be developed here."
                               FontSize="12"
                               Foreground="#71809F"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</UserControl>