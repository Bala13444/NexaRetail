<UserControl x:Class="NexaRetail.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SalesGridColumnHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#08143A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F4F7FC">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="#08143A">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>


                <StackPanel Grid.Row="0"
                            VerticalAlignment="Center"
                            Margin="25,0">

                    <TextBlock Text="NEXARETAIL"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="ERP MANAGEMENT SYSTEM"
                               FontSize="8"
                               Foreground="#7FA4E8"
                               Margin="0,4,0,0"/>

                </StackPanel>


                <StackPanel Grid.Row="1"
                            Margin="15,20,15,0">

                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand"
                            Click="DashboardButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="▣"
                                       FontSize="16"
                                       Width="35"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Dashboard"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="#1D4ED8"
                            BorderThickness="0"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◈"
                                       FontSize="16"
                                       Width="35"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Sales"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◈"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Purchase"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>


                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◈"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Inventory"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>


                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◈"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Customers"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>


                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◈"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Suppliers"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>


                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◈"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Reports"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>


                    <Button Height="48"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B9C9EA"
                            HorizontalContentAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⚙"
                                       FontSize="16"
                                       Width="35"/>

                            <TextBlock Text="Settings"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>

                </StackPanel>


                <Border Grid.Row="2"
                        BorderBrush="#263B67"
                        BorderThickness="0,1,0,0">

                    <StackPanel Margin="20,12">

                        <TextBlock Text="System Administrator"
                                   FontSize="11"
                                   Foreground="White"/>

                        <TextBlock Text="Administrator"
                                   FontSize="9"
                                   Foreground="#7FA4E8"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <Grid Grid.Column="1"
              Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Grid Grid.Row="0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Sales"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="#15213F"/>

                    <TextBlock Text="Dummy sales invoices for preview"
                               FontSize="11"
                               Foreground="#71809F"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <Border HorizontalAlignment="Right"
                        Width="190"
                        Height="48"
                        Background="White"
                        CornerRadius="8">

                    <StackPanel VerticalAlignment="Center"
                                Margin="15,0">

                        <TextBlock Text="System Administrator"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#15213F"/>

                        <TextBlock Text="Administrator"
                                   FontSize="9"
                                   Foreground="#71809F"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <Grid Grid.Row="1"
                  Margin="0,20,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0"
                        Margin="0,0,12,0"
                        Background="White"
                        CornerRadius="10">

                    <StackPanel Margin="20">

                        <TextBlock Text="TODAY'S SALES"
                                   FontSize="11"
                                   Foreground="#71809F"/>

                        <TextBlock Text="{Binding TodaySales, StringFormat=₹ {0:N2}}"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#15213F"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="29 Oct 2026"
                                   FontSize="9"
                                   Foreground="#71809F"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <Border Grid.Column="1"
                        Margin="6,0"
                        Background="White"
                        CornerRadius="10">

                    <StackPanel Margin="20">

                        <TextBlock Text="INVOICES"
                                   FontSize="11"
                                   Foreground="#71809F"/>

                        <TextBlock Text="{Binding InvoiceCount}"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#15213F"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Total invoices"
                                   FontSize="9"
                                   Foreground="#71809F"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <Border Grid.Column="2"
                        Margin="6,0"
                        Background="White"
                        CornerRadius="10">

                    <StackPanel Margin="20">

                        <TextBlock Text="PENDING"
                                   FontSize="11"
                                   Foreground="#71809F"/>

                        <TextBlock Text="{Binding PendingCount}"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#15213F"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Credit invoices"
                                   FontSize="9"
                                   Foreground="#71809F"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <Border Grid.Column="3"
                        Margin="12,0,0,0"
                        Background="White"
                        CornerRadius="10">

                    <StackPanel Margin="20">

                        <TextBlock Text="COLLECTED"
                                   FontSize="11"
                                   Foreground="#71809F"/>

                        <TextBlock Text="{Binding PaidAmount, StringFormat=₹ {0:N2}}"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#15213F"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Paid invoices"
                                   FontSize="9"
                                   Foreground="#71809F"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <Border Grid.Row="2"
                    Margin="0,20,0,0"
                    Background="White"
                    CornerRadius="10"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Recent Sales"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#15213F"
                               Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Sales}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E6ECF5"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFD"
                              FontSize="12"
                              Foreground="#15213F"
                              RowHeight="40"
                              ColumnHeaderStyle="{StaticResource SalesGridColumnHeaderStyle}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Invoice No"
                                                Binding="{Binding InvoiceNo}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding SaleDate, StringFormat=dd-MMM-yyyy}"
                                                Width="130"/>

                            <DataGridTextColumn Header="Customer"
                                                Binding="{Binding CustomerName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Item"
                                                Binding="{Binding ItemName}"
                                                Width="140"/>

                            <DataGridTextColumn Header="Qty"
                                                Binding="{Binding Quantity}"
                                                Width="70"/>

                            <DataGridTextColumn Header="Amount"
                                                Binding="{Binding Amount, StringFormat=₹ {0:N2}}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Payment"
                                                Binding="{Binding PaymentMode}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="100"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>
