<UserControl x:Class="NexaRetail.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:NexaRetail.Helpers">

    <Grid Background="{StaticResource LoginBackgroundBrush}">

        <!-- ===================================================== -->
        <!-- BACKGROUND GLOW - BLUE -->
        <!-- ===================================================== -->

        <Ellipse Width="650"
                 Height="650"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-300,0,0,-300"
                 Opacity="0.30">

            <Ellipse.Fill>
                <RadialGradientBrush>

                    <GradientStop Color="#176BFF"
                                  Offset="0"/>

                    <GradientStop Color="#173B9A"
                                  Offset="0.35"/>

                    <GradientStop Color="#07143D"
                                  Offset="1"/>

                </RadialGradientBrush>
            </Ellipse.Fill>

        </Ellipse>


        <!-- ===================================================== -->
        <!-- BACKGROUND GLOW - PURPLE -->
        <!-- ===================================================== -->

        <Ellipse Width="600"
                 Height="600"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-300,-250,0"
                 Opacity="0.25">

            <Ellipse.Fill>
                <RadialGradientBrush>

                    <GradientStop Color="#9B2CF5"
                                  Offset="0"/>

                    <GradientStop Color="#5A1FA5"
                                  Offset="0.35"/>

                    <GradientStop Color="#07143D"
                                  Offset="1"/>

                </RadialGradientBrush>
            </Ellipse.Fill>

        </Ellipse>


        <!-- ===================================================== -->
        <!-- MAIN TWO COLUMN LAYOUT -->
        <!-- ===================================================== -->

        <Grid Margin="60,30,60,30">

            <Grid.ColumnDefinitions>

                <!-- LEFT SIDE -->
                <ColumnDefinition Width="45*"/>

                <!-- RIGHT SIDE -->
                <ColumnDefinition Width="55*"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- LEFT SIDE -->
            <!-- ================================================= -->

            <Grid Grid.Column="0">

                <StackPanel Width="320"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">


                    <!-- WPF TITLE -->

                    <TextBlock Text="WPF"
                               FontSize="52"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBlueBrush}"
                               HorizontalAlignment="Left"/>


                    <TextBlock Text="POWERED APPLICATION"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="3,-3,0,40"
                               HorizontalAlignment="Left"/>


                    <!-- APPLICATION NAME -->

                    <TextBlock Text="NEXARETAIL"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Left"/>


                    <TextBlock Text="ERP MANAGEMENT SYSTEM"
                               FontSize="9"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,5,0,35"
                               HorizontalAlignment="Left"/>


                    <!-- FEATURES -->

                    <StackPanel>

                        <TextBlock Text="◈   SALES"
                                   FontSize="13"
                                   Foreground="#D8E4FF"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="◈   INVENTORY"
                                   FontSize="13"
                                   Foreground="#D8E4FF"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="◈   PURCHASE"
                                   FontSize="13"
                                   Foreground="#D8E4FF"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="◈   REPORTS"
                                   FontSize="13"
                                   Foreground="#D8E4FF"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="◈   MANAGEMENT"
                                   FontSize="13"
                                   Foreground="#D8E4FF"/>

                    </StackPanel>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- RIGHT SIDE -->
            <!-- ================================================= -->

            <Grid Grid.Column="1">

                <!-- LOGIN CARD -->

                <Border Width="440"
                        Height="580"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="14"
                        Background="#E6101D49"
                        BorderBrush="#4167C5"
                        BorderThickness="1"
                        Effect="{StaticResource CardShadow}">


                    <!-- CARD CONTENT -->

                    <Grid Margin="38">

                        <!-- ROW DEFINITIONS -->

                        <Grid.RowDefinitions>

                            <!-- Logo -->
                            <RowDefinition Height="105"/>

                            <!-- Welcome -->
                            <RowDefinition Height="75"/>

                            <!-- Username -->
                            <RowDefinition Height="70"/>

                            <!-- Password -->
                            <RowDefinition Height="70"/>

                            <!-- Remember / Forgot -->
                            <RowDefinition Height="40"/>

                            <!-- Login -->
                            <RowDefinition Height="65"/>

                            <!-- Footer -->
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <!-- ===================================== -->
                        <!-- LOGO -->
                        <!-- ===================================== -->

                        <StackPanel Grid.Row="0"
                                    HorizontalAlignment="Center">


                            <!-- LOGO BOX -->

                            <Border Width="58"
                                    Height="58"
                                    CornerRadius="16">

                                <Border.Background>

                                    <LinearGradientBrush
                                        StartPoint="0,0"
                                        EndPoint="1,1">

                                        <GradientStop Color="#18A8F5"
                                                      Offset="0"/>

                                        <GradientStop Color="#8B2CF5"
                                                      Offset="1"/>

                                    </LinearGradientBrush>

                                </Border.Background>


                                <TextBlock Text="N"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <!-- COMPANY NAME -->

                            <TextBlock Text="NEXARETAIL"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>


                            <TextBlock Text="ERP MANAGEMENT SYSTEM"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>

                        </StackPanel>


                        <!-- ===================================== -->
                        <!-- WELCOME -->
                        <!-- ===================================== -->

                        <StackPanel Grid.Row="1"
                                    Margin="0,5,0,0">

                            <TextBlock Text="Welcome Back"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>


                            <TextBlock Text="Sign in to continue to NexaRetail"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,0"/>

                        </StackPanel>


                        <!-- ===================================== -->
                        <!-- USERNAME -->
                        <!-- ===================================== -->

                        <StackPanel Grid.Row="2">

                            <TextBlock Text="Username"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#D8E4FF"
                                       Margin="0,0,0,7"/>


                            <Border Height="44"
                                    CornerRadius="7"
                                    Background="{StaticResource InputBackgroundBrush}"
                                    BorderBrush="{StaticResource InputBorderBrush}"
                                    BorderThickness="1">


                                <Grid>

                                    <!-- USER ICON -->

                                    <TextBlock Text="◉"
                                               Width="38"
                                               FontSize="13"
                                               Foreground="#6E8CD8"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>


                                    <!-- USERNAME TEXTBOX -->

                                    <TextBox Text="{Binding UserName,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                             Margin="38,0,8,0"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="White"
                                             CaretBrush="White"
                                             FontSize="13"
                                             VerticalContentAlignment="Center"/>

                                </Grid>

                            </Border>

                        </StackPanel>


                        <!-- ===================================== -->
                        <!-- PASSWORD -->
                        <!-- ===================================== -->

                        <StackPanel Grid.Row="3"
                                    Margin="0,0,0,0">

                            <TextBlock Text="Password"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#D8E4FF"
                                       Margin="0,0,0,7"/>


                            <Border Height="44"
                                    CornerRadius="7"
                                    Background="{StaticResource InputBackgroundBrush}"
                                    BorderBrush="{StaticResource InputBorderBrush}"
                                    BorderThickness="1">


                                <Grid>

                                    <!-- PASSWORD ICON -->

                                    <TextBlock Text="●"
                                               Width="38"
                                               FontSize="12"
                                               Foreground="#6E8CD8"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>


                                    <!-- PASSWORD -->

                                    <PasswordBox x:Name="txtPassword"
                                                 helpers:PasswordBoxHelper.Password="{Binding Password,
                                                 Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="38,0,8,0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="White"
                                                 FontSize="13"
                                                 VerticalContentAlignment="Center"/>

                                </Grid>

                            </Border>

                        </StackPanel>


                        <!-- ===================================== -->
                        <!-- REMEMBER / FORGOT -->
                        <!-- ===================================== -->

                        <Grid Grid.Row="4">


                            <!-- REMEMBER ME -->

                            <CheckBox Content="Remember me"
                                      FontSize="11"
                                      Foreground="#AFC3F7"
                                      VerticalAlignment="Center"/>


                            <!-- FORGOT PASSWORD -->

                            <TextBlock Text="Forgot Password?"
                                       FontSize="11"
                                       Foreground="#5DB7FF"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"/>

                        </Grid>


                        <!-- ===================================== -->
                        <!-- LOGIN BUTTON -->
                        <!-- ===================================== -->

                        <Button Grid.Row="5"
                                Height="45"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding LoginCommand}"
                                Effect="{StaticResource ButtonShadow}">


                            <!-- BUTTON BACKGROUND -->

                            <Button.Background>

                                <LinearGradientBrush
                                    StartPoint="0,0"
                                    EndPoint="1,0">

                                    <GradientStop Color="#18A8F5"
                                                  Offset="0"/>

                                    <GradientStop Color="#315CF5"
                                                  Offset="0.5"/>

                                    <GradientStop Color="#9B2CF5"
                                                  Offset="1"/>

                                </LinearGradientBrush>

                            </Button.Background>


                            <!-- BUTTON TEXT -->

                            <Button.Content>

                                <TextBlock Text="LOGIN   →"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Button.Content>

                        </Button>


                        <!-- ===================================== -->
                        <!-- FOOTER -->
                        <!-- ===================================== -->

                        <TextBlock Grid.Row="6"
                                   Text="© 2026 NexaRetail. All rights reserved."
                                   FontSize="9"
                                   Foreground="#667DB5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,2"/>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>